menu "Ayla configuration"

config AYLA_WIFI_SUPPORT
	bool "Ayla Wi-Fi support"
	default y

config AYLA_WIFI_SETUP_CLEARTEXT_SUPPORT
	bool "Ayla Wi-Fi setup in cleartext mode support"
	depends on AYLA_WIFI_SUPPORT
	default y

config AYLA_BLUETOOTH_SUPPORT
	bool "Ayla Bluetooth support"
	default y

config AYLA_LOCAL_CONTROL_SUPPORT
	bool "Ayla Local Control support"
	default y

config AYLA_LOCAL_CONTROL_SUPPORT_WLT
	bool "Ayla Local Control support WLT protocols"
	depends on AYLA_LOCAL_CONTROL_SUPPORT
	default n

choice
    prompt "Product class"
    default AYLA_BULB

config AYLA_BULB
    bool "Bulb"

config AYLA_PLUG
    bool "Plug"

config AYLA_STRIP
    bool "Strip"

config AYLA_LEDEVB
    bool "LEDEVB"
    help
      Obsoleted

endchoice

endmenu
